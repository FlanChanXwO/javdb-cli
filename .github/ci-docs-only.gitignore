# Scoped Git-ignore syntax consumed by scripts/classify-change-scope.sh.
# Positive patterns are documentation-only. Negated patterns are container-required.
/README.md
/README.*.md
/AGENTS.md
/CLAUDE.md
/CONTRIBUTING.md
/CONTRIBUTING.*.md
/CHANGELOG.md
/CHANGELOG.*.md
/.gitignore
/.pre-commit-config.yaml
/.github/CODEOWNERS
/.github/PULL_REQUEST_TEMPLATE.md
/.github/ISSUE_TEMPLATE/**
/docs/**
/changelog/**
/skills/**
/.agents/skills/**

!/Dockerfile
!/.dockerignore
!/go.mod
!/go.sum
!/LICENSE
!/cmd/**
!/internal/**
!/sdk/**
!/ci/**
!/tools/platformmatrix/**
!/scripts/build-release.sh
